{
  "name": "insighthunter-bizforma",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 execute BIZFORMA_DB --local --file ./src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute BIZFORMA_DB --remote --file ./src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250321.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.7.1"
  }
}
