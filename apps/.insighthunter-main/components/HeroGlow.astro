---
---
<div class="hero-glow" aria-hidden="true">
  <svg viewBox="0 0 640 520" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
    <defs>
      <radialGradient id="glow1" cx="30%" cy="20%" r="60%">
        <stop offset="0%" stop-color="#00F0C8" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#00F0C8" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="glow2" cx="80%" cy="70%" r="55%">
        <stop offset="0%" stop-color="#5FA8FF" stop-opacity="0.4" />
        <stop offset="100%" stop-color="#5FA8FF" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#00F0C8" />
        <stop offset="100%" stop-color="#5FA8FF" />
      </linearGradient>
    </defs>
    <rect width="640" height="520" fill="url(#glow1)" />
    <rect width="640" height="520" fill="url(#glow2)" />

    <g stroke="rgba(233,237,243,0.08)" stroke-width="1">
      <line x1="0" y1="130" x2="640" y2="130" />
      <line x1="0" y1="260" x2="640" y2="260" />
      <line x1="0" y1="390" x2="640" y2="390" />
    </g>

    <path
      d="M40 400 C 140 380, 190 300, 260 260 S 380 160, 460 120 S 560 80, 600 60"
      fill="none"
      stroke="url(#lineGrad)"
      stroke-width="3"
      stroke-linecap="round"
      class="trend-path"
    />
    <circle cx="460" cy="120" r="6" fill="#00F0C8" class="pulse-dot" />
  </svg>

  <div class="glass-card card-1">
    <span class="glass-label mono">MRR</span>
    <span class="glass-value mono">$48,210</span>
    <span class="glass-delta mono">▲ 18.4%</span>
  </div>
  <div class="glass-card card-2">
    <span class="glass-label mono">Runway</span>
    <span class="glass-value mono">14 mo</span>
  </div>
  <div class="glass-card card-3">
    <span class="glass-label mono">Cash today</span>
    <span class="glass-value mono">$212,400</span>
  </div>
</div>

<style>
  .hero-glow { position: relative; width: 100%; }
  .hero-glow svg { width: 100%; height: auto; display: block; }
  .trend-path { stroke-dasharray: 900; stroke-dashoffset: 900; animation: draw 1.8s ease-out 0.15s forwards; }
  .pulse-dot { animation: pulse 2.2s ease-in-out infinite; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes pulse { 0%,100% { r: 6; opacity: 1; } 50% { r: 9; opacity: 0.5; } }
  @media (prefers-reduced-motion: reduce) {
    .trend-path { animation: none; stroke-dashoffset: 0; }
    .pulse-dot { animation: none; }
  }

  .glass-card {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    background: rgba(22, 29, 40, 0.65);
    border: 1px solid rgba(233, 237, 243, 0.14);
    border-radius: 10px;
    backdrop-filter: blur(10px);
    box-shadow: 0 12px 32px -12px rgba(0,0,0,0.5);
  }
  .glass-label { font-size: 0.68rem; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.08em; }
  .glass-value { font-size: 1.05rem; color: var(--ink); font-weight: 600; }
  .glass-delta { font-size: 0.72rem; color: var(--amber); }

  .card-1 { top: 8%; left: 4%; }
  .card-2 { top: 62%; left: 66%; }
  .card-3 { top: 40%; left: 30%; }

  @media (max-width: 780px) {
    .glass-card { padding: 8px 12px; }
    .glass-value { font-size: 0.85rem; }
    .card-3 { display: none; }
  }
</style>
