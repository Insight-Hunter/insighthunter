{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insighthunter-marketing",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",

  "routes": [
    { "pattern": "insighthunter.app/*",     "zone_name": "insighthunter.app" },
    { "pattern": "www.insighthunter.app/*", "zone_name": "insighthunter.app" }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Rate-limit the public contact form (no PII stored — see src/lib/rate-limit.ts).
  // Replace placeholder IDs with real namespace IDs before first deploy.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "1a34ccfa48cd47bab83eef40c5586945",
      "preview_id": "1a34ccfa48cd47bab83eef40c5586945"
    },
    {
      "binding": "LEADS",
      "id": "3f9b5938564948569f7ce8d73cac769e",
      "preview_id": "3f9b5938564948569f7ce8d73cac769e"
    }
  ],

  "vars": {
    "CANONICAL_ORIGIN": "https://insighthunter.app",
    "AUTH_ORIGIN":      "https://auth.insighthunter.app",
    "APP_ORIGIN":       "https://app.insighthunter.app",
    "CONTACT_TO_EMAIL": "sales@insighthunter.app"
  }
}
