---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Insight Hunter | Business services, insights, and AI CFO Assistance',
  description = 'Insight Hunter helps small businesses run with bookkeeping, payroll, PBX, formation support, website services, and decision-ready business insights.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
