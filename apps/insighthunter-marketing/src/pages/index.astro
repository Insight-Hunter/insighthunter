---
import HeroGlow from "../components/HeroGlow.astro";
import { MODULES } from "../data/modules";
import Layout from "../layouts/Layout.astro";
---
<Layout title="Insight Hunter — Business Services and Insights">
  <!-- STAGE 1: HERO — Attention -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Business services and insights for every stage</p>
        <h1>Hunt Down Business Insights. <span class="grad-text">Get the Support to Grow.</span></h1>
        <p class="hero-sub">
          Insight Hunter brings bookkeeping, payroll, PBX business phone,
          business formation assistance, and website services together&mdash;
          alongside the insights that help you make informed decisions as your
          business grows.
        </p>
        <div class="hero-actions">
          <a href="https://app.insighthunter.app" class="btn btn-primary">Explore Business Services</a>
          <a href="https://app.insighthunter.app" class="btn btn-ghost">View Plans</a>
        </div>
        <p class="hero-fine mono">Practical tools for starting, operating, and growing a business.</p>
      </div>
      <div class="hero-visual">
        <HeroGlow />
      </div>
    </div>
  </section>

  <!-- STAGE 2: PAIN — Interest -->
  <section class="ruled pain-section">
    <div class="wrap">
      <p class="eyebrow">Less juggling, more clarity</p>
      <h2>Bring essential business support together.</h2>
      <p class="section-lead">
        Bookkeeping, payroll, business phone, formation, and website needs can
        pull your attention in different directions. Insight Hunter brings
        these services together with business insights to help you stay focused
        on building and growing your company.
      </p>
    </div>
  </section>

  <!-- STAGE 3: PROOF — Consideration -->
  <section class="ruled stat-bar">
    <div class="wrap stat-grid">
      <div class="stat">
        <span class="stat-num mono">Bookkeeping</span>
        <span class="stat-label">organized financial records and clearer business visibility</span>
      </div>
      <div class="stat">
        <span class="stat-num mono">Payroll &amp; PBX</span>
        <span class="stat-label">essential people and communications services for daily operations</span>
      </div>
      <div class="stat">
        <span class="stat-num mono">Formation &amp; web</span>
        <span class="stat-label">support for getting established and building your online presence</span>
      </div>
    </div>
  </section>

  <!-- STAGE 4: FEATURES — Consideration -->
  <section class="ruled">
    <div class="wrap">
      <p class="eyebrow">Support for the work of running a business</p>
      <div class="feature-grid">
        <div class="feature-card">
          <span class="feature-num grad-text mono">01</span>
          <h3>Bookkeeping &amp; insights</h3>
          <p>Organize business finances and make more informed decisions with useful financial context.</p>
        </div>
        <div class="feature-card">
          <span class="feature-num grad-text mono">02</span>
          <h3>Payroll &amp; PBX</h3>
          <p>Bring pay operations and business communications into the tools you use to run your company.</p>
        </div>
        <div class="feature-card">
          <span class="feature-num grad-text mono">03</span>
          <h3>Formation &amp; website services</h3>
          <p>Get assistance establishing your business and services to build a clear online presence.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STAGE 5: URGENCY — Decision / Action -->
  <section class="ruled dark cta-section">
    <div class="wrap cta-inner">
      <div>
        <p class="eyebrow" style="color: var(--amber);">Build your business with Insight Hunter</p>
        <h2>Get the support and tools to move forward.</h2>
        <p>Explore the services, compare plans, and choose the support that fits your business needs.</p>
      </div>
      <a href="https://app.insighthunter.app" class="btn btn-on-dark">Explore plans</a>
    </div>
  </section>

  <style>
    .hero { padding-top: 72px; padding-bottom: 96px; background: var(--paper); }
    .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
    .hero-sub { font-size: 1.12rem; }
    .hero-actions { display: flex; gap: 14px; margin: 28px 0 18px; flex-wrap: wrap; }
    .hero-fine { font-size: 0.8rem; color: var(--moss); }
    .grad-text {
      background: linear-gradient(90deg, var(--amber), var(--moss));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .pain-section { background: var(--paper); }
    .section-lead { font-size: 1.08rem; max-width: 68ch; }

    .stat-bar { background: var(--panel); }
    .stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .stat { display: flex; flex-direction: column; gap: 6px; }
    .stat-num { font-size: 2rem; color: var(--amber); font-weight: 600; }
    .stat-label { font-size: 0.88rem; color: var(--ink-soft); max-width: 30ch; }

    .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 32px; }
    .feature-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; transition: border-color 0.2s ease, transform 0.2s ease; }
    .feature-card:hover { border-color: var(--amber); transform: translateY(-2px); }
    .feature-num { font-size: 1.6rem; font-weight: 700; }
    .feature-card h3 { margin: 12px 0 8px; font-size: 1.15rem; }
    .feature-card p { margin: 0; font-size: 0.92rem; }

    .cta-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; }
    .cta-inner p { max-width: 44ch; }

    @media (max-width: 860px) {
      .hero-grid { grid-template-columns: 1fr; }
      .stat-grid { grid-template-columns: 1fr; gap: 20px; }
      .feature-grid { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
