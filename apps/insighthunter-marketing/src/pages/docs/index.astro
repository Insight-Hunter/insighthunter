---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const items = await getCollection("docs");
---
<BaseLayout title="Docs — Insight Hunter">
  <section class="section">
    <div class="container">
      <div class="eyebrow">Documentation</div>
      <h1 class="page-title">Implementation, setup, and product reference.</h1>
      <div class="grid cards-2">
        {items.map((item) => (
          <article class="card">
            <div class="eyebrow">{item.data.section}</div>
            <h2>{item.data.title}</h2>
            <p>{item.data.description}</p>
            <a class="btn btn-secondary" href={`/docs/${item.slug}`}>Open doc</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
