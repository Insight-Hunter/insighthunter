// apps/insighthunter-bills/wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insighthunter-bills",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    { "pattern": "bills.insighthunter.app/*", "zone_name": "insighthunter.app" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "insighthunter-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "AUTH_URL": "https://auth.insighthunter.app",
    "DASHBOARD_URL": "https://app.insighthunter.app",
    "ENVIRONMENT": "production"
  }
}
