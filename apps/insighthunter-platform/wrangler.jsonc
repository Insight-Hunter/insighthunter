{
  "name": "insighthunter-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "routes": [
    {
      "pattern": "platform.insighthunter.app/*",
      "zone_name": "insighthunter.app"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "insighthunter-auth-db",
      "database_id": "1b58d27d-77c0-481d-a490-0c043f0e063c"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV_SESSIONS",
      "id": "60e34ba310ca40c79edec05470c7a271"
    },
    {
      "binding": "KV_ENTITLEMENTS",
      "id": "8ac9bbaeda4d410db31878ebb8b8a3f1"
    }
  ],

  "vars": {
    "AUTH_URL": "https://auth.insighthunter.app",
    "DASHBOARD_URL": "https://app.insighthunter.app",
    "STRIPE_PORTAL_URL": ""
  }

  // Secrets (set via wrangler secret put):
  // wrangler secret put STRIPE_PORTAL_URL --name insighthunter-platform
}
