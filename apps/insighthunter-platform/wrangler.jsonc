{
  "name": "insighthunter-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "routes": [
    {
      "pattern": "platform.insighthunter.app/*",
      "zone_name": "insighthunter.app"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "insighthunter-db",
      "database_id": "4c00676f-9023-4f25-a634-17817594ea0b"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV_SESSIONS",
      "id": "084631d3b2704097a57e57d89daee600"
    },
    {
      "binding": "KV_ENTITLEMENTS",
      "id": "8ac9bbaeda4d410db31878ebb8b8a3f1"
    }
  ],

  "vars": {
    "AUTH_URL": "https://auth.insighthunter.app",
    "DASHBOARD_URL": "https://app.insighthunter.app"
  }

  // wrangler secret put STRIPE_PORTAL_URL --name insighthunter-platform
}
