{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insighthunter-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "routes": [
    {
      "pattern": "platform.insighthunter.app/*",
      "zone_name": "insighthunter.app"
    }
  ],

  // Shared D1 — same database as insighthunter-auth
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "insighthunter-db",
      "database_id": "1b58d27d-77c0-481d-a490-0c043f0e063c"
    }
  ],

  "kv_namespaces": [
    {
      // Shared session store — same KV as insighthunter-auth
      "binding": "KV_SESSIONS",
      "id": "60e34ba310ca40c79edec05470c7a271"
    },
    {
      // Entitlements cache — separate KV namespace (create with: wrangler kv namespace create KV_ENTITLEMENTS)
      "binding": "KV_ENTITLEMENTS",
      "id": "f55ebc7692604c949033c9bbc459d6fd"
    }
  ],

  "vars": {
    "AUTH_URL": "https://auth.insighthunter.app",
    "DASHBOARD_URL": "https://app.insighthunter.app",
    "STRIPE_PORTAL_URL": ""
  }

  // Secrets — set with wrangler secret put:
  // wrangler secret put STRIPE_PORTAL_URL --name insighthunter-platform
  //
  // KV + D1 IDs — copy from insighthunter-auth/wrangler.jsonc once provisioned:
  //   KV_SESSIONS id  = same id as insighthunter-auth KV_SESSIONS
  //   D1 database_id  = same id as insighthunter-auth DB
  //   KV_ENTITLEMENTS = new namespace, create with:
  //     wrangler kv namespace create KV_ENTITLEMENTS --name insighthunter-platform
}
