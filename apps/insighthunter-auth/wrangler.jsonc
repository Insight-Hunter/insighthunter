{
  // Insight Hunter Auth Worker — wrangler.jsonc
  "name": "insighthunter-auth",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  "routes": [
    { "pattern": "auth.insighthunter.app/*", "zone_name": "insighthunter.app" }
  ],

  "observability": { "enabled": true },

  // Static assets served from src/frontend/
  "assets": {
    "binding": "ASSETS",
    "directory": "./src/frontend"
  },

  // D1 — shared auth database (per-tenant DBs provisioned at runtime)
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "insighthunter-auth",
      "database_id": "<REPLACE_WITH_D1_DATABASE_ID>",
      "migrations_dir": "src/db/migrations"
    }
  ],

  // KV — active session cache
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "<REPLACE_WITH_KV_NAMESPACE_ID>"
    }
  ],

  // Queue — tenant provisioning
  "queues": {
    "producers": [
      {
        "binding": "PROVISIONING_QUEUE",
        "queue": "ih-provisioning"
      }
    ],
    "consumers": [
      {
        "queue": "ih-provisioning",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "ih-provisioning-dlq"
      }
    ]
  },

  // Durable Objects
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["RateLimiter"]
    }
  ],

  // Analytics Engine
  "analytics_engine_datasets": [
    {
      "binding": "AUTH_ANALYTICS",
      "dataset": "ih_auth_events"
    }
  ],

  // Service bindings
  "services": [
    {
      "binding": "BOOKKEEPING_SERVICE",
      "service": "insighthunter-bookkeeping"
    }
  ],

  // Non-secret vars (secrets set via `wrangler secret put`)
  "vars": {
    "MARKETING_ORIGIN": "https://insighthunter.app",
    "APP_ORIGIN": "https://app.insighthunter.app",
    "ACCESS_TOKEN_TTL_SECONDS": "900",
    "REFRESH_TOKEN_TTL_SECONDS": "2592000"
  }
  // Secrets (never in vars):
  //   JWT_SECRET
  //   STRIPE_SECRET_KEY
  //   STRIPE_WEBHOOK_SECRET
  //   CF_API_TOKEN
  //   CF_ACCOUNT_ID
}
