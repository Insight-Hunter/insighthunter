{
  "name": "insighthunter-main",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
     "dev":          "astro dev",
     "build":        "astro build",
     "deploy:worker": "wrangler deploy",
     "deploy:site":  "astro build && wrangler pages deploy dist --project-name insighthunter-marketing",
     "deploy":       "pnpm deploy:worker",
     "preview":      "wrangler dev",
     "typecheck":    "tsc -p tsconfig.json --noEmit"
  },

  "dependencies": {
    "@insighthunter/auth-shared": "workspace:*",
    "hono": "^4.6.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250701.0"
  }
}
