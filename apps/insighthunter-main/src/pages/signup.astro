---
import Layout from '../layouts/Layout.astro';
import { registerUrl, type Plan } from "../lib/auth-links";

const requestedPlan = Astro.url.searchParams.get("plan");
const plan: Plan =
  requestedPlan === "standard" || requestedPlan === "pro"
    ? requestedPlan
    : "lite";

return Astro.redirect(registerUrl(plan), 302);
---

<Layout title="Create your account">
  <section class="auth-section">
    <div class="wrap auth-wrap">
      <div class="auth-card">
        <p class="eyebrow">Get started</p>
        <h1 id="auth-heading">Create your account</h1>
        <p id="tier-note" class="mono tier-note"></p>

        <form id="signup-form">
          <label>
            Work email
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            Password
            <input type="password" name="password" required minlength="10" autocomplete="new-password" />
            <span class="hint">At least 10 characters.</span>
          </label>
          <button type="submit" class="btn btn-primary submit-btn">Create account</button>
          <p id="error-note" class="error-note" role="alert"></p>
        </form>

        <p class="alt-action">Already have an account? <a href="/login">Log in</a></p>
      </div>
    </div>
  </section>

  <script
    define:vars={{
      authApi: import.meta.env.PUBLIC_AUTH_API_URL,
      paymentsApi: import.meta.env.PUBLIC_PAYMENTS_API_URL,
      appBaseUrl: import.meta.env.PUBLIC_APP_BASE_URL,
    }}
  >
    const params = new URLSearchParams(window.location.search);
    const requestedTier = params.get('tier') || 'startup';
    const requestedAddon = params.get('addon');

    if (requestedTier !== 'startup') {
      document.getElementById('tier-note').textContent =
        `Creating a ${requestedTier} account — you'll be sent to secure checkout next.`;
    }

    const form = document.getElementById('signup-form');
    const errorNote = document.getElementById('error-note');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorNote.textContent = '';
      const submitBtn = form.querySelector('.submit-btn');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creating account…';

const requestedPlan = Astro.url.searchParams.get("plan");
const plan: Plan =
  requestedPlan === "standard" || requestedPlan === "pro"
    ? requestedPlan
    : "lite";

return Astro.redirect(registerUrl(plan), 302);
---
