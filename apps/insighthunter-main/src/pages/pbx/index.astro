---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getSignupUrl } from '../../lib/urls';
---

<MarketingLayout title="Keep customer communication connected to operations. | Insight Hunter" description="The PBX module is designed to connect calling, voicemail, SMS, and customer communication workflows through qualified partners.">
  <section class="wrap module-page">
    <p class="eyebrow">PBX and communications</p>
    <h1>Keep customer communication connected to operations.</h1>
    <p class="lead">The PBX module is designed to connect calling, voicemail, SMS, and customer communication workflows through qualified partners.</p>

    <div class="module-grid">
      <article><h2>Business calling</h2><p>Centralize business phone workflows instead of mixing them with personal devices.</p></article>
      <article><h2>Message visibility</h2><p>Organize voicemail and SMS activity in one business communication hub.</p></article>
      <article><h2>Partner-powered service</h2><p>Use proven communications infrastructure while maintaining a unified workflow.</p></article>
    </div>

    <a class="btn btn-primary" href={getSignupUrl('startup')}>Get started</a>
  </section>
</MarketingLayout>

<style>
  .module-page { padding-block: 5rem; }
  .lead { max-width: 65ch; color: var(--ink-soft); font-size: 1.1rem; }
  .module-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 2rem 0; }
  article { border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); padding: 1.5rem; }
  article h2 { font-size: 1.2rem; }
  article p { color: var(--ink-soft); }
  @media (max-width: 760px) { .module-grid { grid-template-columns: 1fr; } }
</style>
