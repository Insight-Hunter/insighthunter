---
import { pricing } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Pricing — Insight Hunter">
  <section class="section">
    <div class="container">
      <div class="eyebrow">Pricing</div>
      <h1 class="page-title">Transparent plans for operators who need clarity.</h1>
      <p class="lead">Use Lite to get started, Standard to replace fragmented finance tooling, and Pro when you need a broader operating system.</p>
      <div class="grid cards-3" style="margin-top:2rem;">
        {pricing.map((plan) => (
          <article class="card" style={plan.featured ? 'border-color: var(--primary);' : ''}>
            <h2>{plan.name}</h2>
            <div class="metric">{plan.price}<span style="font-size:1rem; color:var(--muted);">{plan.cadence}</span></div>
            <p>{plan.description}</p>
            <ul>
              {plan.bullets.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
