---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About — Insight Hunter">
  <section class="section">
    <div class="container prose">
      <div class="eyebrow">About us</div>
      <h1 class="page-title">Built for owners who need financial clarity without enterprise overhead.</h1>
      <p class="lead">Insight Hunter is a finance operating layer for small businesses that want better bookkeeping, payroll context, forecasting, and AI-guided insight in one system.</p>
      <div class="card">
        <p>Small businesses deserve enterprise-grade visibility without enterprise-grade implementation drag.</p>
        <p>The platform combines automation, reporting, and decision support so operators can move faster with less guesswork.</p>
      </div>
    </div>
  </section>
</BaseLayout>
