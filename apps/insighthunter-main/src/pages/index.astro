---
import BaseLayout from '../layouts/BaseLayout.astro';
import { features, pricing, site } from '../data/site';
---

<MarketingLayout
  title="Insight Hunter | Finance intelligence for growing businesses"
  description="Insight Hunter combines AI financial analysis, bookkeeping support, reporting, and operational visibility in one Cloudflare edge-powered platform."
>
  <section class="hero">
    <div class="container hero-shell">
      <div class="hero-copy-wrap">
        <div class="hero-badge">
          <span class="flame-mark" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M35.4 6C40.8 14.7 42.3 21.4 39.8 27.1C47.3 27.9 53 34.1 53 42.2C53 51.5 45.3 58 34.7 58C22.6 58 14 50.3 14 39.2C14 29.6 20 22.9 27.8 18.2C27.7 23.5 29.8 27.3 33.3 30.2C35.2 26.9 36.5 22.8 35.7 18.2C35 14.3 33.8 10.5 35.4 6Z" fill="#F97316" />
              <path d="M34.1 24.8C38.8 29.4 41 33.8 41 38.3C41 44.2 36.7 48.4 30.9 48.4C25.7 48.4 21.8 44.6 21.8 39.6C21.8 35.3 24.7 31.8 29.5 28.9C29.8 32 31.4 34.6 34 36.7C35.2 33.8 35.6 29.8 34.1 24.8Z" fill="#FDBA74" />
            </svg>
          </span>
          <span>Cloudflare edge-powered finance intelligence</span>
        </div>

        <h1>Your Financial Nervous System.<br/>See every number that matters.</h1>

        <p class="hero-copy">
          InsightHunter brings together AI financial analysis, automated bookkeeping,
          multi-entity reporting, and operational visibility in one workspace.
          See what changed, what needs attention, and what to do next without chasing
          spreadsheets, disconnected tools, or delayed reports.
        </p>

      <div class="hero-actions">
  <a href="/pricing" class="btn btn-primary">Start your subscription</a>
  <a href="/pricing" class="btn btn-secondary">Explore pricing</a>
</div>


        <div class="hero-metrics">
          <div>
            <strong>One workspace</strong>
            <span>Finance visibility, reporting, and workflows together.</span>
          </div>
          <div>
            <strong>Edge-powered</strong>
            <span>Fast, resilient delivery with Cloudflare infrastructure.</span>
          </div>
          <div>
            <strong>Built for action</strong>
            <span>Answers that help operators move quicker and with more confidence.</span>
          </div>
        </div>
      </div>
      <div class="subtle-panel">
        <div class="grid cards-2">
          <div class="card"><div class="kicker">Typical stack replaced</div><div class="metric">5-9 tools</div><p>Reduce context switching across bookkeeping, reporting, and finance operations.</p></div>
          <div class="card"><div class="kicker">Decision speed</div><div class="metric">Same day</div><p>Give owners and advisors current visibility instead of month-late spreadsheets.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="eyebrow">Platform capabilities</div>
      <h2 class="page-title">One system for the numbers that run the business.</h2>
      <div class="grid cards-3">
        {features.map((feature) => (
          <article class="card">
            <h3>{feature.title}</h3>
            <p>{feature.summary}</p>
            <a href={`/features/${feature.slug}`} class="eyebrow">Read more</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="feature-section">
    <div class="container">
      <div class="section-heading narrow">
        <p class="section-kicker">Core capabilities</p>
        <h2>Features that match how real businesses run.</h2>
        <p>
          Designed to connect finance, reporting, and operator workflows in one platform
          so teams can move from insight to action quickly.
        </p>
      </div>

      <div class="feature-grid">
        <article>
          <h3>Bookkeeping</h3>
          <p>Automate categorization, support reconciliations, and keep the books cleaner with less manual effort.</p>
        </article>
        <article>
          <h3>AI financial analysis</h3>
          <p>Turn raw financial data into plain-language answers, trend signals, and next-step guidance.</p>
        </article>
        <article>
          <h3>Multi-entity reporting</h3>
          <p>See company-level and entity-level views without stitching together spreadsheets by hand.</p>
        </article>
        <article>
          <h3>Cash flow visibility</h3>
          <p>Understand movement, pressure points, and timing with faster, clearer operational context.</p>
        </article>
        <article>
          <h3>Operational visibility</h3>
          <p>Keep finance and business activity connected so leaders can spot issues before they become problems.</p>
        </article>
        <article>
          <h3>Cloudflare edge platform</h3>
          <p>Deliver a fast, resilient experience powered by Cloudflare infrastructure and edge deployment.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-shell">
        <div>
          <p class="section-kicker">Get started</p>
          <h2>Build a clearer operating view for your business.</h2>
          <p>
            Explore the platform, review the features, and start using a system built to
            make financial visibility easier to act on.
          </p>
        </div>

        <div class="cta-actions">
          <a href="/signup" class="btn btn-primary">Start your subscription</a>
          <a href="/features" class="btn btn-secondary">Explore features</a>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  :root {
    --bg: #07111f;
    --bg-deep: #0b1629;
    --panel: rgba(12, 22, 40, 0.82);
    --panel-strong: rgba(16, 28, 51, 0.92);
    --border: rgba(148, 163, 184, 0.16);
    --text: #f8fafc;
    --muted: rgba(226, 232, 240, 0.76);
    --muted-strong: rgba(226, 232, 240, 0.9);
    --accent: #f97316;
    --accent-soft: #fdba74;
    --accent-glow: rgba(249, 115, 22, 0.22);
    --hero-shadow: 0 28px 80px rgba(2, 6, 23, 0.35);
  }

  .hero {
    padding: 92px 0 72px;
    background:
      radial-gradient(circle at top left, rgba(249, 115, 22, 0.16), transparent 28%),
      radial-gradient(circle at top right, rgba(34, 211, 238, 0.10), transparent 26%),
      linear-gradient(180deg, rgba(7, 17, 31, 1) 0%, rgba(9, 19, 35, 1) 100%);
  }

  .container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(320px, 0.88fr);
    gap: 28px;
    align-items: stretch;
  }

  .hero-copy-wrap {
    padding: 8px 0;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px 10px 12px;
    margin-bottom: 22px;
    border-radius: 999px;
    border: 1px solid rgba(253, 186, 116, 0.22);
    background: rgba(15, 23, 42, 0.68);
    color: var(--muted-strong);
    font-size: 0.92rem;
    box-shadow: var(--hero-shadow);
  }

  .flame-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: rgba(249, 115, 22, 0.08);
    flex: 0 0 auto;
  }

  h1 {
    margin: 0 0 18px;
    font-size: clamp(2.8rem, 5vw, 4.9rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
    color: var(--text);
    max-width: 12ch;
  }

  .hero-copy {
    max-width: 66ch;
    margin: 0 0 28px;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--muted-strong);
  }

  .hero-actions,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .hero-actions {
    margin-bottom: 34px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primary {
    color: white;
    background: linear-gradient(180deg, var(--accent-soft), var(--accent));
    box-shadow: 0 12px 34px var(--accent-glow);
  }

  .btn-secondary {
    color: var(--text);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.03);
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .hero-metrics div,
  .hero-proof div,
  .value-grid article,
  .feature-grid article {
    padding: 20px;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.015));
    box-shadow: var(--hero-shadow);
  }

  .hero-metrics strong,
  .hero-proof strong,
  .value-grid h3,
  .feature-grid h3 {
    display: block;
    margin-bottom: 10px;
    font-size: 1rem;
    color: #f8fafc;
  }

  .hero-metrics span,
  .hero-proof span,
  .value-grid p,
  .feature-grid p,
  .section-heading p,
  .cta-shell p {
    color: var(--muted);
    line-height: 1.65;
  }

  .hero-panel {
    display: grid;
    gap: 18px;
    align-content: center;
  }

  .hero-panel-card {
    padding: 28px;
    border-radius: 28px;
    border: 1px solid var(--border);
    background:
      linear-gradient(180deg, rgba(15, 23, 42, 0.95), rgba(15, 23, 42, 0.84)),
      radial-gradient(circle at top right, rgba(249, 115, 22, 0.12), transparent 32%);
    box-shadow: var(--hero-shadow);
  }

  .hero-panel-primary {
    border-color: rgba(34, 211, 238, 0.18);
  }

  .panel-label,
  .section-kicker {
    margin: 0 0 12px;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-soft);
    font-weight: 700;
  }

  .hero-panel h2,
  .section-heading h2,
  .cta-shell h2 {
    margin: 0 0 14px;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #f8fafc;
  }

  .hero-panel p {
    margin: 0;
    color: var(--muted-strong);
    line-height: 1.7;
  }

  .hero-proof,
  .value-grid,
  .feature-grid {
    display: grid;
    gap: 18px;
  }

  .hero-proof,
  .value-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .feature-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .value-section,
  .feature-section,
  .cta-section {
    padding: 36px 0 84px;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 30px;
  }

  .section-heading.narrow {
    max-width: 620px;
  }

  <section class="section">
    <div class="container">
      <div class="eyebrow">Pricing</div>
      <h2 class="page-title">Start simple, then grow into the full operating layer.</h2>
      <div class="grid cards-3">
        {pricing.map((plan) => (
          <article class="card" style={plan.featured ? 'border-color: var(--primary); transform: translateY(-4px);' : ''}>
            <h3>{plan.name}</h3>
            <div class="metric">{plan.price}<span style="font-size:1rem; color:var(--muted);">{plan.cadence}</span></div>
            <p>{plan.description}</p>
            <ul>
              {plan.bullets.map((item) => <li>{item}</li>)}
            </ul>
            <a class={plan.featured ? 'btn btn-primary' : 'btn btn-secondary'} href="/pricing">{plan.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
