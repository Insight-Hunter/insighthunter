---
import Layout from '../layouts/Layout.astro';
import HeroGlow from '../components/HeroGlow.astro';
import { MODULES } from '../data/modules';
---
<Layout title="Know your numbers before your competitors do">
  <!-- STAGE 1: HERO — Attention -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">The CFO you can't afford, automated</p>
        <h1>Stop guessing.<br /><span class="grad-text">Start knowing.</span></h1>
        <p class="hero-sub">
          Insight Hunter turns raw transactions into real-time answers — margin,
          runway, and cash position, updated the moment they happen, not the
          moment your bookkeeper gets around to it.
        </p>
        <div class="hero-actions">
          <a href="/pricing" class="btn btn-primary">Start free — no card required</a>
          <a href="/modules" class="btn btn-ghost">Watch 90-sec demo</a>
        </div>
        <p class="hero-fine mono">Free forever on Startup. No sales call required.</p>
      </div>
      <div class="hero-visual">
        <HeroGlow />
      </div>
    </div>
  </section>

  <!-- STAGE 2: PAIN — Interest -->
  <section class="ruled pain-section">
    <div class="wrap">
      <p class="eyebrow">The problem with "good enough" books</p>
      <h2>By the time your report lands, the number's already stale.</h2>
      <p class="section-lead">
        A ledger tells you what happened. A $500/month bookkeeper tells you
        what happened, three weeks later. Insight Hunter tells you what's
        happening — margin drift, runway shrinkage, cash gaps — while you can
        still do something about it.
      </p>
    </div>
  </section>

  <!-- STAGE 3: PROOF — Consideration -->
  <section class="ruled stat-bar">
    <div class="wrap stat-grid">
      <div class="stat">
        <span class="stat-num mono">2.3 sec</span>
        <span class="stat-label">avg sync latency from bank feed to dashboard</span>
      </div>
      <div class="stat">
        <span class="stat-num mono">6 modules</span>
        <span class="stat-label">bookkeeping, payroll, reporting, advisory, compliance, comms</span>
      </div>
      <div class="stat">
        <span class="stat-num mono">$0/mo</span>
        <span class="stat-label">Startup tier, forever — upgrade only when you outgrow it</span>
      </div>
    </div>
  </section>

  <!-- STAGE 4: FEATURES — Consideration -->
  <section class="ruled">
    <div class="wrap">
      <p class="eyebrow">Built for speed, not spreadsheets</p>
      <div class="feature-grid">
        <div class="feature-card">
          <span class="feature-num grad-text mono">01</span>
          <h3>Real-time data engine</h3>
          <p>Bank, payroll, and invoice feeds sync continuously on the edge — no overnight batch jobs, no stale numbers.</p>
        </div>
        <div class="feature-card">
          <span class="feature-num grad-text mono">02</span>
          <h3>Reports that write themselves</h3>
          <p>P&L, cash flow, and forecasts generate on schedule and land in your inbox before you ask for them.</p>
        </div>
        <div class="feature-card">
          <span class="feature-num grad-text mono">03</span>
          <h3>Add-ons that scale with you</h3>
          <p>Layer on payroll, formation compliance, or webhook alerts only the day your business actually needs them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STAGE 5: URGENCY — Decision / Action -->
  <section class="ruled dark cta-section">
    <div class="wrap cta-inner">
      <div>
        <p class="eyebrow" style="color: var(--amber);">Your books, illuminated</p>
        <h2>Set up in under 5 minutes. See real numbers today.</h2>
        <p>No card required for Startup. Cancel anytime. Upgrade the day reports, payroll, or advisory pay for themselves.</p>
      </div>
      <a href="/pricing" class="btn btn-on-dark">Claim your free dashboard</a>
    </div>
  </section>

  <style>
    .hero { padding-top: 72px; padding-bottom: 96px; background: var(--paper); }
    .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
    .hero-sub { font-size: 1.12rem; }
    .hero-actions { display: flex; gap: 14px; margin: 28px 0 18px; flex-wrap: wrap; }
    .hero-fine { font-size: 0.8rem; color: var(--moss); }
    .grad-text {
      background: linear-gradient(90deg, var(--amber), var(--moss));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .pain-section { background: var(--paper); }
    .section-lead { font-size: 1.08rem; max-width: 68ch; }

    .stat-bar { background: var(--panel); }
    .stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .stat { display: flex; flex-direction: column; gap: 6px; }
    .stat-num { font-size: 2rem; color: var(--amber); font-weight: 600; }
    .stat-label { font-size: 0.88rem; color: var(--ink-soft); max-width: 30ch; }

    .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 32px; }
    .feature-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; transition: border-color 0.2s ease, transform 0.2s ease; }
    .feature-card:hover { border-color: var(--amber); transform: translateY(-2px); }
    .feature-num { font-size: 1.6rem; font-weight: 700; }
    .feature-card h3 { margin: 12px 0 8px; font-size: 1.15rem; }
    .feature-card p { margin: 0; font-size: 0.92rem; }

    .cta-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; }
    .cta-inner p { max-width: 44ch; }

    @media (max-width: 860px) {
      .hero-grid { grid-template-columns: 1fr; }
      .stat-grid { grid-template-columns: 1fr; gap: 20px; }
      .feature-grid { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
