---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import KPICard from '../../components/dashboard/KPICard.svelte';

const session = Astro.locals.session;

const kpis = [
  { label: 'Cash visibility', value: '$184.2K', delta: '+12.4%', tone: 'up' },
  { label: 'Collections pace', value: '18 days', delta: '-3.1 days', tone: 'up' },
  { label: 'Expense variance', value: '4.8%', delta: '-1.6%', tone: 'up' },
  { label: 'Urgent items', value: '3', delta: 'Needs review', tone: 'neutral' }
];
---

<DashboardLayout
  title="Overview"
  description="Insight Hunter dashboard for cash flow, advisory, compliance, and finance operating visibility."
>
  <section class="dashboard-hero">
    <div>
      <p class="eyebrow">Command center</p>
      <h2>Operate the business with financial context.</h2>
      <p class="lede">
        This workspace is designed to bring together the main product surfaces: AI advisory,
        documents, compliance, and monetized finance workflows.
      </p>
    </div>

    <div class="hero-actions">
      <a href="/advisor" class="btn btn-primary">Open advisor</a>
      <a href="/pricing" class="btn btn-secondary">Manage plan</a>
    </div>
  </section>

  <section class="kpi-grid">
    {#each kpis as item}
      <KPICard label={item.label} value={item.value} delta={item.delta} tone={item.tone} />
    {/each}
  </section>

  <section class="content-grid">
    <article class="panel wide">
      <div class="panel-head">
        <div>
          <p class="eyebrow">Finance posture</p>
          <h3>What deserves attention now</h3>
        </div>
        <span class="chip">Live operating summary</span>
      </div>
      <div class="bullet-grid">
        <div class="bullet-card">
          <strong>Cash flow confidence improving.</strong>
          <p>Collection timing and spend discipline are moving in the right direction.</p>
        </div>
        <div class="bullet-card">
          <strong>Compliance should stay visible.</strong>
          <p>Use the calendar and vault flow together so deadlines and source documents remain linked.</p>
        </div>
        <div class="bullet-card">
          <strong>Advisory can be productized.</strong>
          <p>The AI workspace should become the decision layer that ties metrics to recommended action.</p>
        </div>
      </div>
    </article>

    <article class="panel">
      <p class="eyebrow">Launch points</p>
      <h3>Core modules</h3>
      <ul class="link-list">
        <li><a href="/advisor">Advisor workspace</a></li>
        <li><a href="/documents">Document vault</a></li>
        <li><a href="/compliance">Compliance calendar</a></li>
        <li><a href="/pricing">Billing and entitlements</a></li>
      </ul>
    </article>

    <article class="panel">
      <p class="eyebrow">Session</p>
      <h3>Authenticated operator</h3>
      <div class="session-box">
        <strong>{session?.name || 'Insight Hunter user'}</strong>
        <span>{session?.email || 'Signed in through Cloudflare Access'}</span>
      </div>
    </article>
  </section>
</DashboardLayout>

<style>
  .dashboard-hero,
  .panel {
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(16, 27, 46, 0.78);
    border-radius: 24px;
    box-shadow: 0 22px 56px rgba(0,0,0,0.2);
  }

  .dashboard-hero {
    padding: 26px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: end;
    margin-bottom: 22px;
  }

  .eyebrow {
    margin: 0 0 10px;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7db4ff;
    font-weight: 700;
  }

  h2,
  h3 {
    margin: 0 0 10px;
    letter-spacing: -0.03em;
    color: #f4f7fb;
  }

  .lede,
  .bullet-card p,
  .session-box span,
  .link-list a {
    color: #92a4bf;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 800;
    transition: transform 0.18s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primary {
    background: #59a7ff;
    color: white;
  }

  .btn-secondary {
    border: 1px solid rgba(255,255,255,0.1);
    color: #f4f7fb;
    background: rgba(255,255,255,0.02);
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 22px;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 18px;
  }

  .wide {
    grid-column: 1 / -1;
  }

  .panel {
    padding: 22px;
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: start;
    margin-bottom: 18px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(89,167,255,0.12);
    color: #9ec6ff;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .bullet-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .bullet-card {
    padding: 18px;
    border-radius: 18px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
  }

  .bullet-card strong,
  .session-box strong {
    display: block;
    color: #f4f7fb;
    margin-bottom: 8px;
  }

  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .link-list a {
    text-decoration: none;
  }

  .link-list a:hover {
    color: #cfe1ff;
  }

  .session-box {
    padding: 16px;
    border-radius: 18px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
  }

  @media (max-width: 980px) {
    .dashboard-hero,
    .kpi-grid,
    .content-grid,
    .bullet-grid {
      grid-template-columns: 1fr;
      display: grid;
    }
  }
</style>
