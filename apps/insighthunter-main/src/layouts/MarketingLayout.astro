---
export interface Props {
  title: string;
  description?: string;
  isAuthenticated?: boolean;
  dashboardUrl?: string;
  logoutUrl?: string;
}

const loginUrl = 'https://auth.insighthunter.app/login';
const signupUrl = 'https://auth.insighthunter.app/signup';

const {
  title,
  description = 'Insight Hunter — finance intelligence for growing businesses',
  isAuthenticated = false,
  dashboardUrl = '/dashboard',
  logoutUrl = 'https://auth.insighthunter.app/logout',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">Insight Hunter</a>
         <nav class="nav-links">
          <a href="/pricing">Pricing</a>
          {isAuthenticated ? (
            <>
              <a href={dashboardUrl}>Dashboard</a>
              <a href={logoutUrl} class="cta">Sign out</a>
            </>
          ) : (
            <>
              <a href={loginUrl}>Log in</a>
              <a href={signupUrl} class="cta">Get started</a>
            </>
          )}
        </nav>

      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>&copy; 2026 Insight Hunter</span>
        <nav class="footer-links">
          <a href="/pricing">Pricing</a>
          <a href="mailto:hello@insighthunter.app">Contact</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(:root) {
    color-scheme: dark;
    --bg: #08111f;
    --panel: #101b2e;
    --panel-2: #132138;
    --line: rgba(255, 255, 255, 0.08);
    --text: #f4f7fb;
    --muted: #93a4bd;
    --accent: #59a7ff;
    --shadow: 0 24px 64px rgba(0, 0, 0, 0.28);
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    min-height: 100%;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: radial-gradient(circle at top, rgba(88, 140, 255, 0.08), transparent 30%), var(--bg);
    color: var(--text);
  }

  :global(.container) {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .site-header {
    border-bottom: 1px solid var(--line);
    background: rgba(7, 14, 26, 0.9);
    backdrop-filter: blur(18px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
    font-size: 18px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-links .cta {
    background: var(--accent);
    color: #08111f;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 600;
  }

  main {
    min-height: 60vh;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 24px 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
    font-size: 13px;
  }

  .footer-links {
    display: flex;
    gap: 16px;
  }

  .footer-links a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .header-inner,
    .footer-inner {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
