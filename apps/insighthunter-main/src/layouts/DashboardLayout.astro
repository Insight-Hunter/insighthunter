---
interface Props {
  title: string;
  session: unknown;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Insight Hunter</title>
  </head>
  <body>
    <main><slot /></main>
    <style is:global>
      :root {
        --brand: #45e3b2;
        --brand-2: #63a7ff;
        --dark: #07111f;
        --card: #101e31;
        --border: #243752;
        --text: #edf4ff;
        --muted: #9aaec7;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background: var(--dark);
        color: var(--text);
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      }
      main {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
      }
    </style>
  </body>
</html>
