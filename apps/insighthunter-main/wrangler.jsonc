{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insighthunter-main",
  "compatibility_date": "2026-07-25",
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      "binding": "KV_SESSIONS",
      "id": "084631d3b2704097a57e57d89daee600"
    }
  ],
  "routes": [
    { "pattern": "app.insighthunter.app/*", "zone_name": "insighthunter.app" }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  }
}
