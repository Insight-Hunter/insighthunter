---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "CFO-grade financial clarity for small businesses — bookkeeping, reporting, and advisory that doesn't cost CFO money." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Insight Hunter</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-nav">
      <div class="wrap nav-inner">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true">◈</span>
          <span>Insight Hunter</span>
        </a>
        <nav>
          <a href="/modules">Modules</a>
          <a href="/pricing">Pricing</a>
          <a href="https://auth.insighthunter.app/login" class="nav-login">Log in</a>
          <a href="/pricing" class="btn btn-primary nav-cta">Start free</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <div class="brand footer-brand">
            <span class="brand-mark" aria-hidden="true">◈</span>
            <span>Insight Hunter</span>
          </div>
          <p class="footer-tag">Track down the signal in your numbers.</p>
        </div>
        <div class="footer-cols">
          <div>
            <p class="footer-heading">Product</p>
            <a href="/modules">Modules</a>
            <a href="/pricing">Pricing</a>
          </div>
          <div>
            <p class="footer-heading">Account</p>
            <a href="https://auth.insighthunter.app/login">Log in</a>
            <a href="/pricing">Create account</a>
          </div>
        </div>
      </div>
      <div class="wrap footer-legal">
        <span>© {new Date().getFullYear()} Insight Hunter</span>
        <span>Not a substitute for licensed tax or legal advice.</span>
      </div>
    </footer>

    <style>
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 40;
        background: rgba(233, 237, 231, 0.9);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 18px;
        padding-bottom: 18px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        color: var(--ink);
      }
      .brand-mark { color: var(--amber); }
      nav { display: flex; align-items: center; gap: 28px; }
      nav a {
        text-decoration: none;
        font-size: 0.92rem;
        color: var(--ink-soft);
      }
      nav a:hover { color: var(--ink); }
      .nav-login { font-family: var(--font-mono); font-size: 0.85rem; }
      .nav-cta { padding: 10px 18px; }

      .site-footer {
        background: var(--ink);
        color: var(--paper);
        padding-top: 56px;
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 40px;
        padding-bottom: 40px;
      }
      .footer-brand { color: var(--paper-bright); margin-bottom: 8px; }
      .footer-tag { color: rgba(233, 237, 231, 0.6); font-size: 0.9rem; margin: 0; }
      .footer-cols { display: flex; gap: 64px; }
      .footer-cols a {
        display: block;
        text-decoration: none;
        color: rgba(233, 237, 231, 0.75);
        font-size: 0.9rem;
        margin-bottom: 8px;
      }
      .footer-cols a:hover { color: var(--paper-bright); }
      .footer-heading {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--amber);
        margin: 0 0 12px;
      }
      .footer-legal {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid var(--line-on-dark);
        padding: 20px 32px;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: rgba(233, 237, 231, 0.5);
      }
      @media (max-width: 640px) {
        nav { gap: 16px; }
        .nav-login { display: none; }
        .footer-legal { flex-direction: column; gap: 6px; }
      }
    </style>
  </body>
</html>
