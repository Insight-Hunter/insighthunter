---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Choose a new password">
  <section class="auth-section"><div class="wrap auth-wrap"><div class="auth-card">
    <p class="eyebrow">Account recovery</p><h1>Choose a new password</h1>
    <form id="reset-form">
      <label>New password<input type="password" name="password" required minlength="12" autocomplete="new-password" /></label>
      <button type="submit" class="btn btn-primary submit-btn">Update password</button>
      <p id="note" class="error-note" role="alert"></p>
    </form>
  </div></div></section>
  <script define:vars={{ authApi: import.meta.env.PUBLIC_AUTH_API_URL, appBaseUrl: import.meta.env.PUBLIC_APP_BASE_URL }}>
    const form = document.getElementById('reset-form');
    const note = document.getElementById('note');
    const token = new URLSearchParams(window.location.search).get('token') || '';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('.submit-btn');
      button.disabled = true;
      try {
        const response = await fetch(`${authApi}/reset-password`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token, password: form.password.value }) });
        if (!response.ok) throw new Error('This reset link is invalid or expired.');
        window.location.href = `${appBaseUrl}/login?reset=success`;
      } catch (error) {
        note.textContent = error.message || 'Unable to reset password.';
        button.disabled = false;
      }
    });
  </script>
  <style>.auth-section{padding:72px 0 120px}.auth-wrap{display:flex;justify-content:center}.auth-card{width:100%;max-width:420px;background:var(--paper-bright);border:1px solid var(--line);border-radius:4px;padding:40px}form{display:flex;flex-direction:column;gap:18px;margin-top:20px}label{display:flex;flex-direction:column;gap:6px;font-size:.88rem;color:var(--ink-soft)}input{font-family:var(--font-body);font-size:1rem;padding:11px 13px;border:1px solid var(--line);border-radius:3px;background:#fff;color:var(--ink)}.submit-btn{width:100%;justify-content:center}.error-note{color:var(--clay);font-size:.86rem;min-height:1em}</style>
</Layout>
