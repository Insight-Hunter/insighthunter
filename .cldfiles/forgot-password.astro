---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Reset your password">
  <section class="auth-section"><div class="wrap auth-wrap"><div class="auth-card">
    <p class="eyebrow">Account recovery</p><h1>Forgot your password?</h1>
    <p>Enter your email and we'll send a reset link if an account exists.</p>
    <form id="forgot-form">
      <label>Email<input type="email" name="email" required autocomplete="email" /></label>
      <button type="submit" class="btn btn-primary submit-btn">Send reset link</button>
      <p id="note" class="error-note" role="status"></p>
    </form>
    <p class="alt-action"><a href="/login">Back to log in</a></p>
  </div></div></section>
  <script define:vars={{ authApi: import.meta.env.PUBLIC_AUTH_API_URL }}>
    const form = document.getElementById('forgot-form');
    const note = document.getElementById('note');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('.submit-btn');
      button.disabled = true;
      try {
        const response = await fetch(`${authApi}/forgot-password`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: form.email.value.trim() }) });
        if (!response.ok) throw new Error('Unable to send reset link. Please try again.');
        note.textContent = 'If an account exists for that email, a reset link is on its way.';
      } catch (error) {
        note.textContent = error.message || 'Unable to send reset link. Please try again.';
        button.disabled = false;
      }
    });
  </script>
  <style>.auth-section{padding:72px 0 120px}.auth-wrap{display:flex;justify-content:center}.auth-card{width:100%;max-width:420px;background:var(--paper-bright);border:1px solid var(--line);border-radius:4px;padding:40px}.auth-card p{color:var(--ink-soft)}form{display:flex;flex-direction:column;gap:18px;margin-top:20px}label{display:flex;flex-direction:column;gap:6px;font-size:.88rem;color:var(--ink-soft)}input{font-family:var(--font-body);font-size:1rem;padding:11px 13px;border:1px solid var(--line);border-radius:3px;background:#fff;color:var(--ink)}.submit-btn{width:100%;justify-content:center}.error-note{color:var(--moss);font-size:.86rem;min-height:1em}.alt-action{font-size:.88rem;margin-top:22px;text-align:center}.alt-action a{color:var(--moss)}</style>
</Layout>
